/* ==========================================
   TRECHO RETIRADO DO FINAL DO ARQUIVO stily_test.ss --- PALCO RESPONSIVO DEFINITIVO
   ========================================== */
   .viewport-container {
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center; /* Centraliza o palco verticalmente */
    background-color: var(--bg-page);
    overflow: hidden;
    position: fixed;
    top: 0;
    left: 0;
}

.viewport-frame {
    position: relative;
    width: 95vw; /* Usa quase toda a largura */
    max-width: 1100px; 
    /* A mágica acontece aqui: */
    max-height: 80vh; /* O palco nunca terá mais que 80% da altura da tela */
    aspect-ratio: 16 / 9;
    
    display: flex;
    justify-content: center;
    align-items: flex-end; 
    padding-bottom: 20px; /* Margem interna para o avatar não tocar na borda do palco */
    
    transform-origin: center center;
    transition: all 0.3s ease;
}

/* Garante que o avatar não suba na barra inferior */
#avatar-wrapper {
    position: absolute !important;
    bottom: 5% !important; /* Usa porcentagem para subir com o palco */
    /* ... resto do seu código ... */
}

/* Ajuste do Footer para não cobrir nada */
.footer-fixo {
    height: 40px; /* Altura fixa controlada */
    line-height: 40px;
    z-index: 2000;
}

@media (max-width: 480px) {
    .bubble-grid {
        flex-direction: column; /* No celular, vira uma pilha */
    }
}

------------------------------------------------------
.viewport-frame {
    position: relative;
    width: 100%;
    max-width: 100px; 
    aspect-ratio: 16 / 9;
    display: flex;
    justify-content: center;
    align-items: flex-end; 
    padding-bottom: 80px; /* Alinhamento do "chão" */
    /* Ponto de ancoragem para o zoom não "fugir" da tela */
    transform-origin: center center; 
    flex-shrink: 0;
}
